generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["assessments", "attendance", "audit", "chat", "curriculum", "groups", "notifications", "public", "scheduling", "users"]
}

model User {
  id                  String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String?                   @unique @db.VarChar(255)
  phone               String?                   @unique @db.VarChar(32)
  passwordHash        String                    @db.VarChar(255)
  firstName           String                    @db.VarChar(100)
  lastName            String                    @db.VarChar(100)
  avatarUrl           String?                   @db.VarChar(1024)
  primaryRole         UserRole
  status              UserStatus                @default(pending)
  academicBranch      AcademicBranch?
  curriculumType      CurriculumType?
  supervisedSubjectId String?                   @db.Uuid
  emailVerified       Boolean                   @default(false)
  timezone            String                    @default("Asia/Gaza") @db.VarChar(64)
  locale              String                    @default("ar") @db.VarChar(10)
    nationality         String?                   @db.VarChar(100)
  lastLoginAt         DateTime?                 @db.Timestamptz(6)
  createdAt           DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?                 @db.Timestamptz(6)
  gradedSubmissions   AssessmentSubmission[]    @relation("GraderSubmission")
  submissions         AssessmentSubmission[]    @relation("StudentSubmission")
  createdAssessments  Assessment[]
  markedAttendances   SessionAttendance[]       @relation("AttendanceMarker")
  attendances         SessionAttendance[]       @relation("StudentAttendance")
  participations      ConversationParticipant[]
  sentMessages        Message[]                 @relation("MessageSender")
  sentReports         Report[]                  @relation("ReportSender")
  resolvedReports     Report[]                  @relation("ReportResolver")
  createdExamCamps    ExamPrepCamp[]
  CohortRequest       CohortRequest[]
  notifications       Notification[]
  taughtSessions      Session[]
  roles               UserRoleAssignment[]
  activityLogs        ActivityLog[]             @relation("UserActivityLogs")
  supervisedSubject   Subject?                  @relation("SubjectSupervisors", fields: [supervisedSubjectId], references: [id])

  @@map("users")
  @@schema("users")
}

model UserRoleAssignment {
  userId      String   @db.Uuid
  role        UserRole
  grantedAt   DateTime @default(now()) @db.Timestamptz(6)
  grantedById String?  @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
  @@schema("users")
}

model Subject {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String           @unique @db.VarChar(32)
  nameAr             String           @db.VarChar(150)
  nameEn             String?          @db.VarChar(150)
  description        String?
  iconUrl            String?          @db.VarChar(1024)
  curriculumType     CurriculumType   @default(governmental)
  applicableBranches AcademicBranch[]
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6)
  courses            Course[]
  CohortRequest      CohortRequest[]
  supervisors        User[]           @relation("SubjectSupervisors")

  @@map("subjects")
  @@schema("curriculum")
}

model Course {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId      String              @db.Uuid
  code           String              @unique @db.VarChar(64)
  title          String              @db.VarChar(200)
  slug           String              @unique @db.VarChar(200)
  curriculumType CurriculumType
  academicBranch AcademicBranch
  gradeLevel     GradeLevel
  academicYear   String              @db.VarChar(9)
  description    String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)
  subject        Subject             @relation(fields: [subjectId], references: [id])
  versions       CurriculumVersion[]
  textbooks      Textbook[]

  @@map("courses")
  @@schema("curriculum")
}

model Textbook {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId        String?          @db.Uuid
  title           String           @db.VarChar(200)
  author          String?          @db.VarChar(200)
  publicationYear Int?
  pdfUrl          String           @db.VarChar(1024)
  coverUrl        String?          @db.VarChar(1024)
  totalPages      Int?             @db.SmallInt
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  units           CurriculumUnit[]
  course          Course?          @relation(fields: [courseId], references: [id])

  @@map("textbooks")
  @@schema("curriculum")
}

model CurriculumVersion {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId      String           @db.Uuid
  versionTag    String           @db.VarChar(32)
  status        CurriculumStatus @default(draft)
  isDefault     Boolean          @default(false)
  changelog     String?
  publishedAt   DateTime?        @db.Timestamptz(6)
  publishedById String?          @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @db.Timestamptz(6)
  units         CurriculumUnit[]
  course        Course           @relation(fields: [courseId], references: [id])

  @@unique([courseId, versionTag])
  @@map("curriculum_versions")
  @@schema("curriculum")
}

model CurriculumUnit {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculumVersionId String             @db.Uuid
  textbookId          String?            @db.Uuid
  orderIndex          Int
  title               String             @db.VarChar(200)
  description         String?
  pdfStartPage        Int?               @db.SmallInt
  pdfEndPage          Int?               @db.SmallInt
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)
  lessons             CurriculumLesson[]
  version             CurriculumVersion  @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  textbook            Textbook?          @relation(fields: [textbookId], references: [id])

  @@unique([curriculumVersionId, orderIndex])
  @@map("curriculum_units")
  @@schema("curriculum")
}

model CurriculumLesson {
  id                       String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId                   String              @db.Uuid
  orderIndex               Int
  title                    String              @db.VarChar(200)
  lessonType               String?             @db.VarChar(100)
  domain                   String?             @db.VarChar(150)
  sourceText               String?             @db.VarChar(255)
  learningObjectives       String[]
  learningSequence         Json?
  estimatedDurationMinutes Int?                @db.SmallInt
  teacherGuide             String?
  pdfStartPage             Int?                @db.SmallInt
  pdfEndPage               Int?                @db.SmallInt
  createdAt                DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime            @updatedAt @db.Timestamptz(6)
  assessments              Assessment[]
  questionTemplates        QuestionTemplate[]
  unit                     CurriculumUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sessions                 CurriculumSession[]
  liveSessions             Session[]

  @@unique([unitId, orderIndex])
  @@map("curriculum_lessons")
  @@schema("curriculum")
}

model CurriculumSession {
  id                         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId                   String           @db.Uuid
  orderIndex                 Int
  title                      String           @db.VarChar(200)
  sessionPlan                String?
  recommendedDurationMinutes Int              @default(60) @db.SmallInt
  createdAt                  DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime         @updatedAt @db.Timestamptz(6)
  lesson                     CurriculumLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sessions                   Session[]

  @@unique([lessonId, orderIndex])
  @@map("curriculum_sessions")
  @@schema("curriculum")
}

model Cohort {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId            String             @db.Uuid
  curriculumVersionId String             @db.Uuid
  name                String             @db.VarChar(150)
  code                String             @unique @db.VarChar(64)
  status              CohortStatus       @default(draft)
  minStudents         Int                @default(3) @db.SmallInt
  maxStudents         Int                @default(12) @db.SmallInt
  startDate           DateTime           @db.Date
  endDate             DateTime           @db.Date
  createdById         String?            @db.Uuid
  createdAt           DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @db.Timestamptz(6)
  assessments         Assessment[]
  enrollments         CohortEnrollment[]
  instructors         CohortInstructor[]
  sessions            Session[]

  @@map("cohorts")
  @@schema("groups")
}

model CohortInstructor {
  cohortId     String   @db.Uuid
  teacherId    String   @db.Uuid
  role         String   @default("primary_teacher") @db.VarChar(32)
  assignedAt   DateTime @default(now()) @db.Timestamptz(6)
  assignedById String?  @db.Uuid
  cohort       Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@id([cohortId, teacherId])
  @@map("cohort_instructors")
  @@schema("groups")
}

model CohortEnrollment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId         String           @db.Uuid
  studentId        String           @db.Uuid
  status           EnrollmentStatus @default(applied)
  enrolledAt       DateTime         @default(now()) @db.Timestamptz(6)
  completedAt      DateTime?        @db.Timestamptz(6)
  withdrawnAt      DateTime?        @db.Timestamptz(6)
  withdrawalReason String?
  version          Int              @default(1)
  createdAt        DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @db.Timestamptz(6)
  cohort           Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, studentId])
  @@map("cohort_enrollments")
  @@schema("groups")
}

model Session {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId            String              @db.Uuid
  curriculumSessionId String?             @db.Uuid
  lessonId            String?             @db.Uuid
  teacherId           String              @db.Uuid
  title               String              @db.VarChar(200)
  description         String?
  status              SessionStatus       @default(scheduled)
  scheduledStartTime  DateTime            @db.Timestamptz(6)
  scheduledEndTime    DateTime            @db.Timestamptz(6)
  actualStartTime     DateTime?           @db.Timestamptz(6)
  actualEndTime       DateTime?           @db.Timestamptz(6)
  jitsiRoomName       String?             @db.VarChar(255)
  jitsiJwtToken       String?
  cancellationReason  String?
  rescheduledToId     String?             @db.Uuid
  version             Int                 @default(1)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)
  attendances         SessionAttendance[]
  cohort              Cohort              @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  curriculumSession   CurriculumSession?  @relation(fields: [curriculumSessionId], references: [id])
  lesson              CurriculumLesson?   @relation(fields: [lessonId], references: [id])
  rescheduledTo       Session?            @relation("SessionReschedules", fields: [rescheduledToId], references: [id])
  reschedules         Session[]           @relation("SessionReschedules")
  teacher             User                @relation(fields: [teacherId], references: [id])

  @@map("sessions")
  @@schema("scheduling")
}

model SessionAttendance {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId            String            @db.Uuid
  studentId            String            @db.Uuid
  status               AttendanceStatus  @default(absent_unexcused)
  firstEntryTime       DateTime?         @db.Timestamptz(6)
  lastExitTime         DateTime?         @db.Timestamptz(6)
  totalDurationSeconds Int               @default(0)
  markedById           String?           @db.Uuid
  teacherNotes         String?
  createdAt            DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(6)
  events               AttendanceEvent[]
  markedBy             User?             @relation("AttendanceMarker", fields: [markedById], references: [id])
  session              Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student              User              @relation("StudentAttendance", fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@map("session_attendance")
  @@schema("attendance")
}

model AttendanceEvent {
  id                  BigInt              @id @default(autoincrement())
  sessionAttendanceId String              @db.Uuid
  sessionId           String              @db.Uuid
  studentId           String              @db.Uuid
  eventType           AttendanceEventType
  eventTime           DateTime            @default(now()) @db.Timestamptz(6)
  ipAddress           String?
  clientDeviceInfo    Json?
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  sessionAttendance   SessionAttendance   @relation(fields: [sessionAttendanceId], references: [id], onDelete: Cascade)

  @@map("attendance_events")
  @@schema("attendance")
}

model CohortRequest {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teacherId        String        @db.Uuid
  subjectId        String        @db.Uuid
  suggestedName    String        @db.VarChar(100)
  expectedStudents Int           @db.SmallInt
  notes            String?
  status           RequestStatus @default(pending)
  rejectionReason  String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  subject          Subject       @relation(fields: [subjectId], references: [id])
  teacher          User          @relation(fields: [teacherId], references: [id])

  @@map("cohort_requests")
  @@schema("groups")
}

model Assessment {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId           String                 @db.Uuid
  curriculumLessonId String?                @db.Uuid
  title              String                 @db.VarChar(200)
  description        String?
  type               AssessmentType
  dueDate            DateTime               @db.Timestamptz(6)
  maxScore           Decimal                @db.Decimal(5, 2)
  createdById        String                 @db.Uuid
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(6)
  attachments        AssessmentAttachment[]
  questions          AssessmentQuestion[]
  submissions        AssessmentSubmission[]
  cohort             Cohort                 @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  createdBy          User                   @relation(fields: [createdById], references: [id])
  curriculumLesson   CurriculumLesson?      @relation(fields: [curriculumLessonId], references: [id])

  @@map("assessments")
  @@schema("assessments")
}

model AssessmentAttachment {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String     @db.Uuid
  fileName     String     @db.VarChar(255)
  fileUrl      String     @db.VarChar(1024)
  fileSize     Int
  mimeType     String     @db.VarChar(100)
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_attachments")
  @@schema("assessments")
}

model AssessmentSubmission {
  id           String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String                 @db.Uuid
  studentId    String                 @db.Uuid
  status       SubmissionStatus       @default(draft)
  score        Decimal?               @db.Decimal(5, 2)
  feedback     String?
  submittedAt  DateTime?              @db.Timestamptz(6)
  gradedAt     DateTime?              @db.Timestamptz(6)
  gradedById   String?                @db.Uuid
  version      Int                    @default(1)
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(6)
  assessment   Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  gradedBy     User?                  @relation("GraderSubmission", fields: [gradedById], references: [id])
  student      User                   @relation("StudentSubmission", fields: [studentId], references: [id])
  attachments  SubmissionAttachment[]

  @@unique([assessmentId, studentId])
  @@map("assessment_submissions")
  @@schema("assessments")
}

model SubmissionAttachment {
  id           String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String               @db.Uuid
  fileName     String               @db.VarChar(255)
  fileUrl      String               @db.VarChar(1024)
  fileSize     Int
  mimeType     String               @db.VarChar(100)
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  submission   AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_attachments")
  @@schema("assessments")
}

model Conversation {
  id           String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId     String?                   @db.Uuid
  type         ConversationType
  createdAt    DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                  @updatedAt @db.Timestamptz(6)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
  @@schema("chat")
}

model ConversationParticipant {
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now()) @db.Timestamptz(6)
  lastReadAt     DateTime?    @db.Timestamptz(6)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
  @@schema("chat")
}

model Message {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String        @db.Uuid
  senderId         String        @db.Uuid
  content          String
  status           MessageStatus @default(pending_scan)
  version          Int           @default(1)
  moderationReason String?
  createdAt        DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @db.Timestamptz(6)
  conversation     Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User          @relation("MessageSender", fields: [senderId], references: [id])
  reports          Report[]

  @@map("messages")
  @@schema("chat")
}

model Report {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId       String       @db.Uuid
  reporterId      String       @db.Uuid
  reason          String
  status          ReportStatus @default(submitted)
  resolutionNotes String?
  resolvedById    String?      @db.Uuid
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)
  message         Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter        User         @relation("ReportSender", fields: [reporterId], references: [id])
  resolvedBy      User?        @relation("ReportResolver", fields: [resolvedById], references: [id])

  @@map("reports")
  @@schema("chat")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  title     String           @db.VarChar(150)
  body      String
  type      NotificationType @default(system)
  isRead    Boolean          @default(false)
  actionUrl String?          @db.VarChar(1024)
  createdAt DateTime         @default(now()) @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@schema("notifications")
}

model ExamPrepCamp {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(150)
  description String?
  type        ExamPrepType
  startDate   DateTime     @db.Timestamptz(6)
  endDate     DateTime     @db.Timestamptz(6)
  isActive    Boolean      @default(true)
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  creator     User         @relation(fields: [createdById], references: [id])

  @@map("exam_prep_camps")
  @@schema("curriculum")
}

model QuestionTemplate {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculumLessonId  String               @db.Uuid
  type                QuestionType         @default(multiple_choice)
  content             String
  options             Json?
  correctAnswer       String?
  explanation         String?
  difficulty          Int                  @default(1) @db.SmallInt
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  assessmentQuestions AssessmentQuestion[]
  lesson              CurriculumLesson     @relation(fields: [curriculumLessonId], references: [id], onDelete: Cascade)

  @@map("question_templates")
  @@schema("assessments")
}

model AssessmentQuestion {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId       String           @db.Uuid
  questionTemplateId String           @db.Uuid
  orderIndex         Int
  scoreWeight        Decimal          @default(1.0) @db.Decimal(5, 2)
  assessment         Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionTemplate   QuestionTemplate @relation(fields: [questionTemplateId], references: [id])

  @@unique([assessmentId, questionTemplateId])
  @@map("assessment_questions")
  @@schema("assessments")
}

enum UserRole {
  super_admin
  admin
  subject_supervisor
  tech_support
  teacher
  student

  @@schema("users")
}

enum UserStatus {
  pending
  active
  suspended
  deactivated

  @@schema("users")
}

enum AcademicBranch {
  scientific
  literary
  entrepreneurship
  industrial
  sharia

  @@schema("curriculum")
}

enum CurriculumType {
  governmental
  azhari

  @@schema("curriculum")
}

enum GradeLevel {
  grade_11
  grade_12

  @@schema("curriculum")
}

enum CurriculumStatus {
  draft
  in_review
  published
  archived

  @@schema("curriculum")
}

enum CohortStatus {
  draft
  recruiting
  active
  completed
  cancelled

  @@schema("groups")
}

enum EnrollmentStatus {
  applied
  enrolled
  waitlisted
  completed
  withdrawn
  suspended

  @@schema("groups")
}

enum SessionStatus {
  scheduled
  open
  in_progress
  completed
  cancelled
  rescheduled

  @@schema("scheduling")
}

enum AttendanceStatus {
  present
  late
  absent_excused
  absent_unexcused
  left_early

  @@schema("attendance")
}

enum AttendanceEventType {
  joined
  left
  heartbeat

  @@schema("attendance")
}

enum RequestStatus {
  pending
  approved
  rejected

  @@schema("groups")
}

enum AssessmentType {
  quiz
  assignment
  exam
  project

  @@schema("assessments")
}

enum SubmissionStatus {
  draft
  submitted
  graded
  returned
  resubmitted

  @@schema("assessments")
}

enum ConversationType {
  private
  cohort_group

  @@schema("chat")
}

enum MessageStatus {
  pending_scan
  safe
  flagged
  blocked
  manual_review
  approved
  rejected

  @@schema("chat")
}

enum ReportStatus {
  submitted
  investigating
  resolved
  dismissed

  @@schema("chat")
}

enum NotificationType {
  system
  enrollment
  session_reminder
  assessment
  chat_mention

  @@schema("notifications")
}

enum ExamPrepType {
  quarterly
  final

  @@schema("curriculum")
}

enum QuestionType {
  multiple_choice
  true_false
  short_answer
  essay

  @@schema("assessments")
}

model ActivityLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  action    String   @db.VarChar(100)
  details   String?
  ipAddress String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user      User     @relation("UserActivityLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
  @@schema("users")
}
