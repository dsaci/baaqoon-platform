generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth", "users", "curriculum", "groups", "scheduling", "attendance", "assessments", "chat", "audit", "notifications"]
}

// ============================================================================
// AUTH & USERS SCHEMA
// ============================================================================

enum UserRole {
  super_admin
  admin
  subject_supervisor
  tech_support
  teacher
  student

  @@schema("auth")
}

enum UserStatus {
  pending
  active
  suspended
  deactivated

  @@schema("auth")
}

model User {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String?         @unique @db.VarChar(255)
  phone          String?         @unique @db.VarChar(32)
  passwordHash   String          @db.VarChar(255)
  firstName      String          @db.VarChar(100)
  lastName       String          @db.VarChar(100)
  avatarUrl      String?         @db.VarChar(1024)
  primaryRole    UserRole
  status         UserStatus      @default(pending)
  academicBranch AcademicBranch?
  curriculumType CurriculumType?
  supervisedSubjectId String? @db.Uuid
  supervisedSubject   Subject? @relation("SubjectSupervisors", fields: [supervisedSubjectId], references: [id], onDelete: SetNull)

  emailVerified  Boolean         @default(false)
  timezone       String          @default("Asia/Gaza") @db.VarChar(64)
  locale         String          @default("ar") @db.VarChar(10)
  lastLoginAt    DateTime?       @db.Timestamptz()
  createdAt      DateTime        @default(now()) @db.Timestamptz()
  updatedAt      DateTime        @updatedAt @db.Timestamptz()
  deletedAt      DateTime?       @db.Timestamptz()

  roles              UserRoleAssignment[]
  taughtSessions     Session[]
  attendances        SessionAttendance[]       @relation("StudentAttendance")
  markedAttendances  SessionAttendance[]       @relation("AttendanceMarker")
  createdAssessments Assessment[]
  submissions        AssessmentSubmission[]    @relation("StudentSubmission")
  gradedSubmissions  AssessmentSubmission[]    @relation("GraderSubmission")
  participations     ConversationParticipant[]
  sentMessages       Message[]                 @relation("MessageSender")
  sentReports        Report[]                  @relation("ReportSender")
  resolvedReports    Report[]                  @relation("ReportResolver")
  notifications      Notification[]
  createdExamCamps   ExamPrepCamp[]

  @@map("users")
  @@schema("auth")
}

model UserRoleAssignment {
  userId      String   @db.Uuid
  role        UserRole
  grantedAt   DateTime @default(now()) @db.Timestamptz()
  grantedById String?  @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@map("user_roles")
  @@schema("auth")
}

// ... (Note: For brevity in the MVP scaffolding, other modules like Curriculum,
// Scheduling, and Attendance will be mapped to Prisma models incrementally 
// as we generate the NestJS backend resources to avoid a 2000-line schema initially).

// ============================================================================
// CURRICULUM SCHEMA
// ============================================================================

enum AcademicBranch {
  scientific
  literary
  entrepreneurship
  industrial
  sharia

  @@schema("curriculum")
}

enum CurriculumType {
  governmental
  azhari

  @@schema("curriculum")
}

enum GradeLevel {
  grade_11
  grade_12

  @@schema("curriculum")
}

enum CurriculumStatus {
  draft
  in_review
  published
  archived

  @@schema("curriculum")
}

// ============================================================================
// SCHEMA: curriculum (Subjects, Courses, Units, Lessons)
// ============================================================================

model Subject {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code               String           @unique @db.VarChar(32)
  nameAr             String           @db.VarChar(150)
  nameEn             String?          @db.VarChar(150)
  description        String?
  iconUrl            String?          @db.VarChar(1024)
  curriculumType     CurriculumType   @default(governmental)
  applicableBranches AcademicBranch[]
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now()) @db.Timestamptz()
  updatedAt          DateTime         @updatedAt @db.Timestamptz()

  courses Course[]
  supervisors User[] @relation("SubjectSupervisors")

  @@map("subjects")
  @@schema("curriculum")
}

model Course {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subjectId      String         @db.Uuid
  code           String         @unique @db.VarChar(64)
  title          String         @db.VarChar(200)
  slug           String         @unique @db.VarChar(200)
  curriculumType CurriculumType
  academicBranch AcademicBranch
  gradeLevel     GradeLevel
  academicYear   String         @db.VarChar(9)
  description    String?
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now()) @db.Timestamptz()
  updatedAt      DateTime       @updatedAt @db.Timestamptz()

  subject   Subject             @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  versions  CurriculumVersion[]
  textbooks Textbook[]

  @@map("courses")
  @@schema("curriculum")
}

model Textbook {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId        String?  @db.Uuid
  title           String   @db.VarChar(200)
  author          String?  @db.VarChar(200)
  publicationYear Int?
  pdfUrl          String   @db.VarChar(1024)
  coverUrl        String?  @db.VarChar(1024)
  totalPages      Int?     @db.SmallInt
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now()) @db.Timestamptz()
  updatedAt       DateTime @updatedAt @db.Timestamptz()

  course Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  units  CurriculumUnit[]

  @@map("textbooks")
  @@schema("curriculum")
}

model CurriculumVersion {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId      String           @db.Uuid
  versionTag    String           @db.VarChar(32)
  status        CurriculumStatus @default(draft)
  isDefault     Boolean          @default(false)
  changelog     String?
  publishedAt   DateTime?        @db.Timestamptz()
  publishedById String?          @db.Uuid
  createdAt     DateTime         @default(now()) @db.Timestamptz()
  updatedAt     DateTime         @updatedAt @db.Timestamptz()

  course Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  units  CurriculumUnit[]

  @@unique([courseId, versionTag])
  @@map("curriculum_versions")
  @@schema("curriculum")
}

model CurriculumUnit {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculumVersionId String   @db.Uuid
  textbookId          String?  @db.Uuid
  orderIndex          Int
  title               String   @db.VarChar(200)
  description         String?
  pdfStartPage        Int?     @db.SmallInt
  pdfEndPage          Int?     @db.SmallInt
  createdAt           DateTime @default(now()) @db.Timestamptz()
  updatedAt           DateTime @updatedAt @db.Timestamptz()

  version  CurriculumVersion  @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  textbook Textbook?          @relation(fields: [textbookId], references: [id], onDelete: SetNull)
  lessons  CurriculumLesson[]

  @@unique([curriculumVersionId, orderIndex])
  @@map("curriculum_units")
  @@schema("curriculum")
}

model CurriculumLesson {
  id                       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  unitId                   String   @db.Uuid
  orderIndex               Int
  title                    String   @db.VarChar(200)
  
  // Pedagogical Data
  lessonType               String?  @db.VarChar(100)
  domain                   String?  @db.VarChar(150)
  sourceText               String?  @db.VarChar(255)
  learningObjectives       String[]
  learningSequence         Json?
  
  estimatedDurationMinutes Int?     @db.SmallInt
  teacherGuide             String?
  pdfStartPage             Int?     @db.SmallInt
  pdfEndPage               Int?     @db.SmallInt
  createdAt                DateTime @default(now()) @db.Timestamptz()
  updatedAt                DateTime @updatedAt @db.Timestamptz()

  unit              CurriculumUnit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  sessions          CurriculumSession[]
  liveSessions      Session[]
  assessments       Assessment[]
  questionTemplates QuestionTemplate[]

  @@unique([unitId, orderIndex])
  @@map("curriculum_lessons")
  @@schema("curriculum")
}

model CurriculumSession {
  id                         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId                   String   @db.Uuid
  orderIndex                 Int
  title                      String   @db.VarChar(200)
  sessionPlan                String?
  recommendedDurationMinutes Int      @default(60) @db.SmallInt
  createdAt                  DateTime @default(now()) @db.Timestamptz()
  updatedAt                  DateTime @updatedAt @db.Timestamptz()

  lesson   CurriculumLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([lessonId, orderIndex])
  @@map("curriculum_sessions")
  @@schema("curriculum")
}

// ============================================================================
// GROUPS (COHORTS) SCHEMA
// ============================================================================

enum CohortStatus {
  draft
  recruiting
  active
  completed
  cancelled

  @@schema("groups")
}

enum EnrollmentStatus {
  applied
  enrolled
  waitlisted
  completed
  withdrawn
  suspended

  @@schema("groups")
}

model Cohort {
  id                  String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  courseId            String       @db.Uuid
  curriculumVersionId String       @db.Uuid
  name                String       @db.VarChar(150)
  code                String       @unique @db.VarChar(64)
  status              CohortStatus @default(draft)
  minStudents         Int          @default(3) @db.SmallInt
  maxStudents         Int          @default(12) @db.SmallInt
  startDate           DateTime     @db.Date
  endDate             DateTime     @db.Date
  createdById         String?      @db.Uuid
  createdAt           DateTime     @default(now()) @db.Timestamptz()
  updatedAt           DateTime     @updatedAt @db.Timestamptz()

  instructors CohortInstructor[]
  enrollments CohortEnrollment[]
  sessions    Session[]
  assessments Assessment[]

  @@map("cohorts")
  @@schema("groups")
}

model CohortInstructor {
  cohortId     String   @db.Uuid
  teacherId    String   @db.Uuid
  role         String   @default("primary_teacher") @db.VarChar(32)
  assignedAt   DateTime @default(now()) @db.Timestamptz()
  assignedById String?  @db.Uuid

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@id([cohortId, teacherId])
  @@map("cohort_instructors")
  @@schema("groups")
}

model CohortEnrollment {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId         String           @db.Uuid
  studentId        String           @db.Uuid
  status           EnrollmentStatus @default(applied)
  enrolledAt       DateTime         @default(now()) @db.Timestamptz()
  completedAt      DateTime?        @db.Timestamptz()
  withdrawnAt      DateTime?        @db.Timestamptz()
  withdrawalReason String?
  version          Int              @default(1) // For optimistic locking with XState
  createdAt        DateTime         @default(now()) @db.Timestamptz()
  updatedAt        DateTime         @updatedAt @db.Timestamptz()

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@unique([cohortId, studentId])
  @@map("cohort_enrollments")
  @@schema("groups")
}

// ============================================================================
// SCHEDULING SCHEMA
// ============================================================================

enum SessionStatus {
  scheduled
  open
  in_progress
  completed
  cancelled
  rescheduled

  @@schema("scheduling")
}

model Session {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId            String        @db.Uuid
  curriculumSessionId String?       @db.Uuid
  lessonId            String?       @db.Uuid
  teacherId           String        @db.Uuid
  title               String        @db.VarChar(200)
  description         String?
  status              SessionStatus @default(scheduled)

  scheduledStartTime DateTime  @db.Timestamptz()
  scheduledEndTime   DateTime  @db.Timestamptz()
  actualStartTime    DateTime? @db.Timestamptz()
  actualEndTime      DateTime? @db.Timestamptz()

  jitsiRoomName      String? @db.VarChar(255)
  jitsiJwtToken      String?
  cancellationReason String?
  rescheduledToId    String? @db.Uuid

  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  // Relations
  cohort            Cohort              @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  curriculumSession CurriculumSession?  @relation(fields: [curriculumSessionId], references: [id], onDelete: SetNull)
  lesson            CurriculumLesson?   @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  teacher           User                @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  rescheduledTo     Session?            @relation("SessionReschedules", fields: [rescheduledToId], references: [id], onDelete: SetNull)
  reschedules       Session[]           @relation("SessionReschedules")
  attendances       SessionAttendance[]

  @@map("sessions")
  @@schema("scheduling")
}

// ============================================================================
// ATTENDANCE SCHEMA
// ============================================================================

enum AttendanceStatus {
  present
  late
  absent_excused
  absent_unexcused
  left_early

  @@schema("attendance")
}

enum AttendanceEventType {
  joined
  left
  heartbeat

  @@schema("attendance")
}

model SessionAttendance {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId            String           @db.Uuid
  studentId            String           @db.Uuid
  status               AttendanceStatus @default(absent_unexcused)
  firstEntryTime       DateTime?        @db.Timestamptz()
  lastExitTime         DateTime?        @db.Timestamptz()
  totalDurationSeconds Int              @default(0)
  markedById           String?          @db.Uuid
  teacherNotes         String?

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @updatedAt @db.Timestamptz()

  session  Session           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student  User              @relation("StudentAttendance", fields: [studentId], references: [id], onDelete: Restrict)
  markedBy User?             @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  events   AttendanceEvent[]

  @@unique([sessionId, studentId])
  @@map("session_attendance")
  @@schema("attendance")
}

model AttendanceEvent {
  id                  BigInt              @id @default(autoincrement())
  sessionAttendanceId String              @db.Uuid
  sessionId           String              @db.Uuid
  studentId           String              @db.Uuid
  eventType           AttendanceEventType
  eventTime           DateTime            @default(now()) @db.Timestamptz()
  ipAddress           String? // Prisma doesn't natively support Inet in all methods easily, mapped as String
  clientDeviceInfo    Json?
  createdAt           DateTime            @default(now()) @db.Timestamptz()

  sessionAttendance SessionAttendance @relation(fields: [sessionAttendanceId], references: [id], onDelete: Cascade)

  @@map("attendance_events")
  @@schema("attendance")
}

// ============================================================================
// ASSESSMENTS SCHEMA
// ============================================================================

enum AssessmentType {
  quiz
  assignment
  exam
  project

  @@schema("assessments")
}

enum SubmissionStatus {
  draft
  submitted
  graded
  returned
  resubmitted

  @@schema("assessments")
}

model Assessment {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId           String         @db.Uuid
  curriculumLessonId String?        @db.Uuid
  title              String         @db.VarChar(200)
  description        String?
  type               AssessmentType
  dueDate            DateTime       @db.Timestamptz()
  maxScore           Decimal        @db.Decimal(5, 2)
  createdById        String         @db.Uuid
  createdAt          DateTime       @default(now()) @db.Timestamptz()
  updatedAt          DateTime       @updatedAt @db.Timestamptz()

  cohort           Cohort                 @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  curriculumLesson CurriculumLesson?      @relation(fields: [curriculumLessonId], references: [id], onDelete: SetNull)
  createdBy        User                   @relation(fields: [createdById], references: [id], onDelete: Restrict)
  submissions      AssessmentSubmission[]
  attachments      AssessmentAttachment[]
  questions        AssessmentQuestion[]

  @@map("assessments")
  @@schema("assessments")
}

model AssessmentAttachment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String   @db.Uuid
  fileName     String   @db.VarChar(255)
  fileUrl      String   @db.VarChar(1024)
  fileSize     Int // in bytes
  mimeType     String   @db.VarChar(100)
  createdAt    DateTime @default(now()) @db.Timestamptz()

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("assessment_attachments")
  @@schema("assessments")
}

model AssessmentSubmission {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId String           @db.Uuid
  studentId    String           @db.Uuid
  status       SubmissionStatus @default(draft)
  score        Decimal?         @db.Decimal(5, 2)
  feedback     String?
  submittedAt  DateTime?        @db.Timestamptz()
  gradedAt     DateTime?        @db.Timestamptz()
  gradedById   String?          @db.Uuid
  version      Int              @default(1) // For XState Optimistic Locking
  createdAt    DateTime         @default(now()) @db.Timestamptz()
  updatedAt    DateTime         @updatedAt @db.Timestamptz()

  assessment  Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student     User                   @relation("StudentSubmission", fields: [studentId], references: [id], onDelete: Restrict)
  gradedBy    User?                  @relation("GraderSubmission", fields: [gradedById], references: [id], onDelete: SetNull)
  attachments SubmissionAttachment[]

  @@unique([assessmentId, studentId])
  @@map("assessment_submissions")
  @@schema("assessments")
}

model SubmissionAttachment {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId String   @db.Uuid
  fileName     String   @db.VarChar(255)
  fileUrl      String   @db.VarChar(1024)
  fileSize     Int // in bytes
  mimeType     String   @db.VarChar(100)
  createdAt    DateTime @default(now()) @db.Timestamptz()

  submission AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_attachments")
  @@schema("assessments")
}

// ============================================================================
// CHAT & MODERATION SCHEMA
// ============================================================================

enum ConversationType {
  private
  cohort_group

  @@schema("chat")
}

enum MessageStatus {
  pending_scan
  safe
  flagged
  blocked
  manual_review
  approved
  rejected

  @@schema("chat")
}

enum ReportStatus {
  submitted
  investigating
  resolved
  dismissed

  @@schema("chat")
}

model Conversation {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cohortId  String?          @db.Uuid
  type      ConversationType
  createdAt DateTime         @default(now()) @db.Timestamptz()
  updatedAt DateTime         @updatedAt @db.Timestamptz()

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
  @@schema("chat")
}

model ConversationParticipant {
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now()) @db.Timestamptz()
  lastReadAt     DateTime? @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("conversation_participants")
  @@schema("chat")
}

model Message {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String        @db.Uuid
  senderId         String        @db.Uuid
  content          String        @db.Text
  status           MessageStatus @default(pending_scan)
  version          Int           @default(1)
  moderationReason String?
  createdAt        DateTime      @default(now()) @db.Timestamptz()
  updatedAt        DateTime      @updatedAt @db.Timestamptz()

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  reports      Report[]

  @@map("messages")
  @@schema("chat")
}

model Report {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId       String       @db.Uuid
  reporterId      String       @db.Uuid
  reason          String
  status          ReportStatus @default(submitted)
  resolutionNotes String?
  resolvedById    String?      @db.Uuid
  version         Int          @default(1)
  createdAt       DateTime     @default(now()) @db.Timestamptz()
  updatedAt       DateTime     @updatedAt @db.Timestamptz()

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter   User    @relation("ReportSender", fields: [reporterId], references: [id], onDelete: Restrict)
  resolvedBy User?   @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@map("reports")
  @@schema("chat")
}

// ============================================================================
// NOTIFICATIONS SCHEMA
// ============================================================================

enum NotificationType {
  system
  enrollment
  session_reminder
  assessment
  chat_mention

  @@schema("notifications")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @db.Uuid
  title     String           @db.VarChar(150)
  body      String           @db.Text
  type      NotificationType @default(system)
  isRead    Boolean          @default(false)
  actionUrl String?          @db.VarChar(1024)
  createdAt DateTime         @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
  @@schema("notifications")
}

// ============================================================================
// EXAM PREPARATION SCHEMA
// ============================================================================

enum ExamPrepType {
  quarterly
  final

  @@schema("curriculum")
}

model ExamPrepCamp {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(150)
  description String?      @db.Text
  type        ExamPrepType
  startDate   DateTime     @db.Timestamptz()
  endDate     DateTime     @db.Timestamptz()
  isActive    Boolean      @default(true)
  createdById String       @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz()
  updatedAt   DateTime     @updatedAt @db.Timestamptz()

  creator User @relation(fields: [createdById], references: [id])

  @@map("exam_prep_camps")
  @@schema("curriculum")
}
enum QuestionType {
  multiple_choice
  true_false
  short_answer
  essay

  @@schema("assessments")
}

model QuestionTemplate {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  curriculumLessonId String           @db.Uuid
  type               QuestionType     @default(multiple_choice)
  content            String           @db.Text
  options            Json?            // For multiple choice
  correctAnswer      String?          @db.Text
  explanation        String?          @db.Text
  difficulty         Int              @default(1) @db.SmallInt
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now()) @db.Timestamptz()
  updatedAt          DateTime         @updatedAt @db.Timestamptz()

  lesson CurriculumLesson @relation(fields: [curriculumLessonId], references: [id], onDelete: Cascade)
  assessmentQuestions AssessmentQuestion[]

  @@map("question_templates")
  @@schema("assessments")
}

model AssessmentQuestion {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assessmentId       String           @db.Uuid
  questionTemplateId String           @db.Uuid
  orderIndex         Int
  scoreWeight        Decimal          @default(1.0) @db.Decimal(5,2)

  assessment       Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionTemplate QuestionTemplate @relation(fields: [questionTemplateId], references: [id], onDelete: Restrict)

  @@unique([assessmentId, questionTemplateId])
  @@map("assessment_questions")
  @@schema("assessments")
}
